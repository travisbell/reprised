<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page_title %></title>
  <link rel="stylesheet" href="<%= asset_path("demos.css") %>">
</head>
<body>
  <header class="site">
    <a class="brand" href="/">Reprised demos</a>
    <nav>
      <% DEMOS.each do |path, title, _description| %>
        <a href="<%= path %>"<%== ' aria-current="page"' if current_demo?(path) %>><%= title %></a>
      <% end %>
    </nav>
  </header>
  <main>
    <%= yield %>
  </main>
  <footer>
    <% if route %>
      This page is <code><%= route %></code>, from <code><%= source_of(route) %></code>.
    <% end %>
  </footer>
</body>
</html>
